<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate : les prix évoluent en cours d'année, une mise à jour du
         module ne doit pas les réécrire. -->
    <data noupdate="1">

        <record id="fuel_type_super" model="secretariat.fuel.type">
            <field name="name">Super</field>
            <field name="code">SUP</field>
            <field name="sequence">10</field>
            <field name="uom_label">liter</field>
            <field name="price">875</field>
        </record>

        <record id="fuel_type_gasoil" model="secretariat.fuel.type">
            <field name="name">Gasoil</field>
            <field name="code">GAS</field>
            <field name="sequence">20</field>
            <field name="uom_label">liter</field>
            <field name="price">700</field>
        </record>

        <record id="fuel_type_lubrifiant" model="secretariat.fuel.type">
            <field name="name">Lubrifiant</field>
            <field name="code">LUB</field>
            <field name="sequence">30</field>
            <field name="uom_label">unit</field>
            <field name="price">3500</field>
        </record>

        <record id="fuel_type_huile_moteur" model="secretariat.fuel.type">
            <field name="name">Huile moteur</field>
            <field name="code">HUI</field>
            <field name="sequence">40</field>
            <field name="uom_label">unit</field>
            <field name="price">6000</field>
        </record>

        <record id="fuel_type_gaz" model="secretariat.fuel.type">
            <field name="name">Gaz</field>
            <field name="code">GAZ</field>
            <field name="sequence">50</field>
            <field name="uom_label">unit</field>
            <field name="price">6000</field>
        </record>

        <record id="fuel_type_b12" model="secretariat.fuel.type">
            <field name="name">B12</field>
            <field name="code">B12</field>
            <field name="sequence">60</field>
            <field name="uom_label">unit</field>
            <field name="price">10000</field>
        </record>

    </data>
</odoo>
