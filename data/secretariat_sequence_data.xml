<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate : une mise à jour du module ne doit JAMAIS réinitialiser un
         compteur. Un `-u` qui replace `number_next` à 1 ferait repartir la
         numérotation des bons au début, en plein milieu d'un carnet. -->
    <data noupdate="1">

        <!-- ================================================================
             NUMÉROTATION DES BONS — 8 caractères, à partir d'un numéro de
             départ paramétrable (Configuration → Paramètres du secrétariat).

             Le numéro est *proposé*, pas imposé : la souche papier reste la
             référence, la secrétaire peut corriger. Le compteur se recale
             ensuite tout seul sur le plus grand numéro réellement utilisé
             (cf. `_sync_sequence` sur le bon).
             ================================================================ -->
        <record id="seq_secretariat_fuel_voucher" model="ir.sequence">
            <field name="name">Bon de carburant</field>
            <field name="code">secretariat.fuel.voucher</field>
            <field name="implementation">standard</field>
            <field name="prefix"></field>
            <field name="padding">8</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ================================================================
             NUMÉROTATION DES FACTURES DE STATION
             ================================================================ -->
        <record id="seq_secretariat_fuel_invoice" model="ir.sequence">
            <field name="name">Facture de station-service</field>
            <field name="code">secretariat.fuel.invoice</field>
            <field name="implementation">standard</field>
            <field name="prefix">FC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
