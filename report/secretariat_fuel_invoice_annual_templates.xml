<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         ÉTAT ANNUEL DES FACTURES DE STATIONS — A4 paysage

         Douze colonnes de mois plus le total : le portrait ne tient pas.
         Fonds blancs explicites et polices réduites, comme les autres
         états du module.
         ================================================================ -->
    <template id="report_fuel_invoice_annual_document">
        <t t-set="data" t-value="doc.report_data()"/>
        <div class="page" style="font-size:10px;">

            <div style="text-align:center; margin-bottom:12px;">
                <div style="font-size:14px; font-weight:bold;">
                    <span t-field="data['company'].name"/>
                </div>
                <div style="font-size:16px; font-weight:bold; color:#305496; margin-top:4px;">
                    ÉTAT ANNUEL DES FACTURES DE STATIONS
                </div>
                <div style="font-size:12px; margin-top:2px;">
                    Année <span t-esc="data['year']"/>
                </div>
                <div style="font-size:9px; color:#777; margin-top:2px;">
                    Montant retenu : <span t-esc="data['basis_label']"/>
                    <t t-if="not doc.include_draft"> — factures validées et payées uniquement</t>
                </div>
            </div>

            <!-- Matrice stations × mois -->
            <table style="width:100%; border-collapse:collapse; background-color:#fff;
                          font-size:8px; margin-bottom:14px;">
                <thead>
                    <tr style="background-color:#dce6f2;">
                        <th style="text-align:left; padding:3px 4px; border:1px solid #b8cce4;">Station</th>
                        <th t-foreach="data['months']" t-as="month"
                            style="text-align:right; padding:3px 4px; border:1px solid #b8cce4;">
                            <span t-esc="month['short']"/>
                        </th>
                        <th style="text-align:right; padding:3px 4px; border:1px solid #b8cce4;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="data['rows']" t-as="row">
                        <td style="padding:2px 4px; border:1px solid #d9d9d9;">
                            <span t-esc="row['name']"/>
                        </td>
                        <t t-foreach="data['months']" t-as="month">
                            <td style="padding:2px 4px; border:1px solid #d9d9d9; text-align:right;">
                                <span t-if="row['months'][month['index']]"
                                      t-esc="row['months'][month['index']]"
                                      t-options="{'widget': 'float', 'precision': 0}"/>
                                <span t-else="" style="color:#ccc;">—</span>
                            </td>
                        </t>
                        <td style="padding:2px 4px; border:1px solid #d9d9d9;
                                   text-align:right; font-weight:bold;">
                            <span t-esc="row['total']"
                                  t-options="{'widget': 'float', 'precision': 0}"/>
                        </td>
                    </tr>
                </tbody>
                <tfoot>
                    <tr style="background-color:#eef2f9; font-weight:bold;">
                        <td style="padding:3px 4px; border:1px solid #b8cce4;">TOTAL</td>
                        <t t-foreach="data['months']" t-as="month">
                            <td style="padding:3px 4px; border:1px solid #b8cce4; text-align:right;">
                                <span t-esc="data['month_totals'][month['index']]"
                                      t-options="{'widget': 'float', 'precision': 0}"/>
                            </td>
                        </t>
                        <td style="padding:3px 4px; border:1px solid #b8cce4; text-align:right;">
                            <span t-esc="data['grand_total']"
                                  t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                        </td>
                    </tr>
                </tfoot>
            </table>

            <!-- Synthèse -->
            <div style="width:48%; float:left;">
                <div style="font-size:11px; font-weight:bold; color:#305496; margin-bottom:4px;">
                    Synthèse de l'année
                </div>
                <table style="width:100%; border-collapse:collapse; background-color:#fff;
                              font-size:9px;">
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9;">Factures</td>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9; text-align:right;">
                            <span t-esc="data['invoice_count']"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9;">Bons facturés</td>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9; text-align:right;">
                            <span t-esc="data['voucher_count']"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9;">Réglé</td>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9; text-align:right;">
                            <span t-esc="data['paid_amount']"
                                  t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9;">Reste à payer</td>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9;
                                   text-align:right; font-weight:bold;">
                            <span t-esc="data['unpaid_amount']"
                                  t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                        </td>
                    </tr>
                    <tr t-if="data['difference_total']">
                        <td style="padding:3px 6px; border:1px solid #c0392b;
                                   background-color:#fdecea; color:#c0392b;">
                            Écarts cumulés avec les relevés
                        </td>
                        <td style="padding:3px 6px; border:1px solid #c0392b;
                                   background-color:#fdecea; color:#c0392b;
                                   text-align:right; font-weight:bold;">
                            <span t-esc="data['difference_total']"
                                  t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                        </td>
                    </tr>
                </table>
            </div>

            <div t-if="doc.compare_previous" style="width:48%; float:right;">
                <div style="font-size:11px; font-weight:bold; color:#305496; margin-bottom:4px;">
                    Comparaison avec <span t-esc="data['year'] - 1"/>
                </div>
                <table style="width:100%; border-collapse:collapse; background-color:#fff;
                              font-size:9px;">
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9;">
                            Total <span t-esc="data['year'] - 1"/>
                        </td>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9; text-align:right;">
                            <span t-esc="data['previous_total']"
                                  t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9;">
                            Total <span t-esc="data['year']"/>
                        </td>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9;
                                   text-align:right; font-weight:bold;">
                            <span t-esc="data['grand_total']"
                                  t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9;">Variation</td>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9;
                                   text-align:right; font-weight:bold;">
                            <t t-if="data['previous_delta'] is not None">
                                <span t-esc="data['previous_delta']"/> %
                            </t>
                            <t t-else="">
                                <span style="color:#999;">sans référence</span>
                            </t>
                        </td>
                    </tr>
                </table>
            </div>
            <div style="clear:both;"/>

            <!-- Signature -->
            <div style="margin-top:24px; width:40%; float:right; text-align:center; font-size:9px;">
                <div style="border-top:1px solid #333; padding-top:3px; color:#555;">
                    Visa de la direction
                </div>
            </div>
            <div style="clear:both;"/>
        </div>
    </template>

    <template id="report_fuel_invoice_annual">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <t t-call="ivorycocoa_secretariat.report_fuel_invoice_annual_document"/>
                </t>
            </t>
        </t>
    </template>

</odoo>
