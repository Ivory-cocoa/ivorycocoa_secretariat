<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         FACTURE DE STATION — A4

         Document de contrôle : ce que le secrétariat a enregistré, ce que
         la station réclame, et l'écart entre les deux. Les tableaux portent
         un fond blanc explicite — sans classe, le style des rapports Odoo
         les encadre et les grise.
         ================================================================ -->
    <template id="report_fuel_invoice_document">
        <t t-set="data" t-value="doc.report_data()"/>
        <div class="page" style="font-size:11px;">

            <div style="text-align:center; margin-bottom:12px;">
                <div style="font-size:15px; font-weight:bold;">
                    <span t-field="data['company'].name"/>
                </div>
                <div style="font-size:17px; font-weight:bold; color:#305496; margin-top:6px;">
                    FACTURE DE STATION-SERVICE
                </div>
                <div style="font-size:12px; margin-top:2px;">
                    <span t-esc="doc.name"/> — <span t-esc="doc.period_label"/>
                </div>
                <div t-if="doc.state == 'cancelled'"
                     style="color:#c0392b; font-weight:bold; margin-top:4px;">
                    <i class="fa fa-ban"/> FACTURE ANNULÉE
                </div>
            </div>

            <!-- Identification -->
            <table style="width:100%; border-collapse:collapse; background-color:#fff;
                          font-size:10px; margin-bottom:12px;">
                <tr>
                    <td style="width:50%; vertical-align:top; padding:6px 8px;
                               border:1px solid #b8cce4; background-color:#f4f7fb;">
                        <div style="font-weight:bold; color:#305496;">Station</div>
                        <div style="font-size:12px; font-weight:bold;">
                            <span t-field="doc.station_id.name"/>
                        </div>
                        <div t-if="doc.station_invoice_ref">
                            Facture n° <span t-esc="doc.station_invoice_ref"/>
                        </div>
                        <div t-if="doc.station_invoice_date">
                            du <span t-field="doc.station_invoice_date"/>
                        </div>
                    </td>
                    <td style="width:50%; vertical-align:top; padding:6px 8px;
                               border:1px solid #b8cce4; background-color:#f4f7fb;">
                        <div style="font-weight:bold; color:#305496;">Quinzaine</div>
                        <div>
                            du <span t-field="doc.date_from"/>
                            au <span t-field="doc.date_to"/>
                        </div>
                        <div>Bons repris : <b><span t-esc="doc.voucher_count"/></b></div>
                        <div t-if="doc.date_due">
                            Échéance : <span t-field="doc.date_due"/>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- Montants -->
            <table style="width:100%; border-collapse:collapse; background-color:#fff;
                          font-size:11px; margin-bottom:14px;">
                <tr>
                    <td style="padding:6px 8px; border:1px solid #b8cce4;">
                        Total des bons enregistrés
                    </td>
                    <td style="padding:6px 8px; border:1px solid #b8cce4;
                               text-align:right; font-weight:bold;">
                        <span t-esc="doc.amount_total"
                              t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                    </td>
                </tr>
                <tr t-if="doc.statement_amount">
                    <td style="padding:6px 8px; border:1px solid #b8cce4;">
                        Montant réclamé par la station
                    </td>
                    <td style="padding:6px 8px; border:1px solid #b8cce4;
                               text-align:right; font-weight:bold;">
                        <span t-esc="doc.statement_amount"
                              t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                    </td>
                </tr>
                <tr t-if="doc.has_difference">
                    <td style="padding:6px 8px; border:1px solid #c0392b;
                               background-color:#fdecea; color:#c0392b; font-weight:bold;">
                        Écart constaté
                    </td>
                    <td style="padding:6px 8px; border:1px solid #c0392b;
                               background-color:#fdecea; color:#c0392b;
                               text-align:right; font-weight:bold;">
                        <span t-esc="doc.amount_difference"
                              t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                    </td>
                </tr>
            </table>

            <div t-if="doc.has_difference and doc.difference_reason"
                 style="margin-bottom:12px; padding:6px 8px; border:1px solid #f0c36d;
                        background-color:#fdf6e3; font-size:10px;">
                <b>Explication de l'écart :</b>
                <span t-field="doc.difference_reason"/>
            </div>

            <!-- Répartition par carburant -->
            <div style="margin-bottom:12px;">
                <div style="font-size:12px; font-weight:bold; color:#305496; margin-bottom:4px;">
                    Répartition par carburant
                </div>
                <table style="width:100%; border-collapse:collapse; background-color:#fff;
                              font-size:10px;">
                    <thead>
                        <tr style="background-color:#dce6f2;">
                            <th style="text-align:left; padding:4px 6px; border:1px solid #b8cce4;">Carburant</th>
                            <th style="text-align:right; padding:4px 6px; border:1px solid #b8cce4; width:14%;">Bons</th>
                            <th style="text-align:right; padding:4px 6px; border:1px solid #b8cce4; width:18%;">Quantité</th>
                            <th style="text-align:right; padding:4px 6px; border:1px solid #b8cce4; width:22%;">Montant</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="data['by_fuel']" t-as="row">
                            <td style="padding:3px 6px; border:1px solid #d9d9d9;">
                                <span t-esc="row[0]"/>
                            </td>
                            <td style="padding:3px 6px; border:1px solid #d9d9d9; text-align:right;">
                                <span t-esc="row[1]"/>
                            </td>
                            <td style="padding:3px 6px; border:1px solid #d9d9d9; text-align:right;">
                                <span t-esc="row[2]" t-options="{'widget': 'float', 'precision': 2}"/>
                            </td>
                            <td style="padding:3px 6px; border:1px solid #d9d9d9; text-align:right;">
                                <span t-esc="row[3]"
                                      t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Détail des bons -->
            <div>
                <div style="font-size:12px; font-weight:bold; color:#305496; margin-bottom:4px;">
                    Détail des bons
                </div>
                <table style="width:100%; border-collapse:collapse; background-color:#fff;
                              font-size:9px;">
                    <thead>
                        <tr style="background-color:#dce6f2;">
                            <th style="text-align:left; padding:3px 5px; border:1px solid #b8cce4;">N°</th>
                            <th style="text-align:left; padding:3px 5px; border:1px solid #b8cce4;">Émis le</th>
                            <th style="text-align:left; padding:3px 5px; border:1px solid #b8cce4;">Utilisé le</th>
                            <th style="text-align:left; padding:3px 5px; border:1px solid #b8cce4;">Engin</th>
                            <th style="text-align:left; padding:3px 5px; border:1px solid #b8cce4;">Bénéficiaire</th>
                            <th style="text-align:left; padding:3px 5px; border:1px solid #b8cce4;">Carburant</th>
                            <th style="text-align:right; padding:3px 5px; border:1px solid #b8cce4;">P.U.</th>
                            <th style="text-align:right; padding:3px 5px; border:1px solid #b8cce4;">Qté</th>
                            <th style="text-align:right; padding:3px 5px; border:1px solid #b8cce4;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="data['lines']" t-as="voucher">
                            <td style="padding:2px 5px; border:1px solid #d9d9d9;">
                                <span t-esc="voucher.name"/>
                            </td>
                            <td style="padding:2px 5px; border:1px solid #d9d9d9;">
                                <span t-field="voucher.date"/>
                            </td>
                            <td style="padding:2px 5px; border:1px solid #d9d9d9;">
                                <span t-if="voucher.date_used" t-field="voucher.date_used"/>
                                <span t-else="" style="color:#999;">—</span>
                            </td>
                            <td style="padding:2px 5px; border:1px solid #d9d9d9;">
                                <span t-esc="voucher.vehicle_id.name or ''"/>
                            </td>
                            <td style="padding:2px 5px; border:1px solid #d9d9d9;">
                                <span t-esc="voucher.beneficiary_id.name or ''"/>
                            </td>
                            <td style="padding:2px 5px; border:1px solid #d9d9d9;">
                                <span t-esc="voucher.fuel_type_id.name or ''"/>
                            </td>
                            <td style="padding:2px 5px; border:1px solid #d9d9d9; text-align:right;">
                                <span t-esc="voucher.price_unit"
                                      t-options="{'widget': 'float', 'precision': 0}"/>
                            </td>
                            <td style="padding:2px 5px; border:1px solid #d9d9d9; text-align:right;">
                                <span t-esc="voucher.quantity"
                                      t-options="{'widget': 'float', 'precision': 2}"/>
                            </td>
                            <td style="padding:2px 5px; border:1px solid #d9d9d9; text-align:right;">
                                <span t-esc="voucher.amount_total"
                                      t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr style="background-color:#eef2f9; font-weight:bold;">
                            <td colspan="7" style="padding:3px 5px; border:1px solid #b8cce4;">TOTAL</td>
                            <td style="padding:3px 5px; border:1px solid #b8cce4; text-align:right;">
                                <span t-esc="doc.quantity_total"
                                      t-options="{'widget': 'float', 'precision': 2}"/>
                            </td>
                            <td style="padding:3px 5px; border:1px solid #b8cce4; text-align:right;">
                                <span t-esc="doc.amount_total"
                                      t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Signatures -->
            <table style="width:100%; margin-top:26px; border-collapse:collapse;
                          background-color:#fff;">
                <tr>
                    <td style="width:32%; text-align:center; font-size:10px; color:#555;">
                        <div style="border-top:1px solid #333; padding-top:3px;">Le secrétariat</div>
                    </td>
                    <td style="width:2%;"/>
                    <td style="width:32%; text-align:center; font-size:10px; color:#555;">
                        <div style="border-top:1px solid #333; padding-top:3px;">La station</div>
                    </td>
                    <td style="width:2%;"/>
                    <td style="width:32%; text-align:center; font-size:10px; color:#555;">
                        <div style="border-top:1px solid #333; padding-top:3px;">Visa de la direction</div>
                    </td>
                </tr>
            </table>

            <div style="margin-top:10px; font-size:8px; color:#999; text-align:center;">
                Édité le <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y à %H:%M')"/>
            </div>
        </div>
    </template>

    <template id="report_fuel_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <t t-call="ivorycocoa_secretariat.report_fuel_invoice_document"/>
                </t>
            </t>
        </t>
    </template>

</odoo>
