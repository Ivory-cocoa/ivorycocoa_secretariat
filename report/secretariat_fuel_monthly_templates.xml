<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         ÉTAT RÉCAPITULATIF DES BONS DE CARBURANT — A4

         Ce que le classeur calculait à la main en bas de feuille, en plus
         complet : totaux, trois répartitions, dépassements de dotation,
         détail facultatif, ligne de signature.
         ================================================================ -->

    <!-- Bloc de synthèse réutilisé pour les trois répartitions. -->
    <template id="report_fuel_monthly_bucket">
        <div style="margin-bottom:14px;">
            <div style="font-size:12px; font-weight:bold; color:#305496; margin-bottom:4px;">
                <span t-esc="bucket_title"/>
            </div>
            <table style="width:100%; border-collapse:collapse; background-color:#fff; font-size:10px;">
                <thead>
                    <tr style="background-color:#dce6f2;">
                        <th style="text-align:left; padding:4px 6px; border:1px solid #b8cce4;">Libellé</th>
                        <th style="text-align:right; padding:4px 6px; border:1px solid #b8cce4; width:14%;">Bons</th>
                        <th style="text-align:right; padding:4px 6px; border:1px solid #b8cce4; width:18%;">Quantité</th>
                        <th style="text-align:right; padding:4px 6px; border:1px solid #b8cce4; width:22%;">Montant</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="bucket_rows" t-as="row">
                        <td style="padding:3px 6px; border:1px solid #d9d9d9;"><span t-esc="row[0]"/></td>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9; text-align:right;">
                            <span t-esc="row[1]"/>
                        </td>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9; text-align:right;">
                            <span t-esc="row[2]" t-options="{'widget': 'float', 'precision': 2}"/>
                        </td>
                        <td style="padding:3px 6px; border:1px solid #d9d9d9; text-align:right;">
                            <span t-esc="row[3]"
                                  t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

    <template id="report_fuel_monthly_document">
        <t t-set="data" t-value="doc.report_data()"/>
        <div class="page" style="font-size:11px;">

            <div style="text-align:center; margin-bottom:14px;">
                <div style="font-size:17px; font-weight:bold; color:#305496;">
                    ÉTAT RÉCAPITULATIF DES BONS DE CARBURANT
                </div>
                <div style="font-size:13px; margin-top:2px;">
                    <span t-esc="data['period_label']"/>
                </div>
                <div t-if="doc.vehicle_ids or doc.beneficiary_ids or doc.fuel_type_ids"
                     style="font-size:9px; color:#777; margin-top:2px;">
                    <i class="fa fa-filter"/> État filtré —
                    <span t-if="doc.fuel_type_ids">
                        carburants : <span t-esc="', '.join(doc.fuel_type_ids.mapped('name'))"/>.
                    </span>
                    <span t-if="doc.vehicle_ids">
                        engins : <span t-esc="', '.join(doc.vehicle_ids.mapped('name'))"/>.
                    </span>
                    <span t-if="doc.beneficiary_ids">
                        bénéficiaires : <span t-esc="', '.join(doc.beneficiary_ids.mapped('name'))"/>.
                    </span>
                </div>
                <div t-if="not doc.include_draft" style="font-size:9px; color:#777;">
                    Bons validés uniquement.
                </div>
            </div>

            <!-- Totaux -->
            <table style="width:100%; border-collapse:collapse; background-color:#fff; margin-bottom:16px;">
                <tr>
                    <td style="width:33%; border:1px solid #305496; padding:8px; text-align:center;">
                        <div style="font-size:9px; color:#555;">NOMBRE DE BONS</div>
                        <div style="font-size:18px; font-weight:bold; color:#305496;">
                            <span t-esc="data['count']"/>
                        </div>
                    </td>
                    <td style="width:33%; border:1px solid #305496; padding:8px; text-align:center;">
                        <div style="font-size:9px; color:#555;">QUANTITÉ TOTALE</div>
                        <div style="font-size:18px; font-weight:bold; color:#305496;">
                            <span t-esc="data['quantity']" t-options="{'widget': 'float', 'precision': 2}"/>
                        </div>
                    </td>
                    <td style="width:34%; border:1px solid #305496; padding:8px; text-align:center;">
                        <div style="font-size:9px; color:#555;">MONTANT TOTAL</div>
                        <div style="font-size:18px; font-weight:bold; color:#305496;">
                            <span t-esc="data['amount']"
                                  t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                        </div>
                    </td>
                </tr>
            </table>

            <!-- Dépassements de dotation -->
            <div t-if="data['over_quota']" style="margin-bottom:14px;">
                <div style="font-size:12px; font-weight:bold; color:#c0392b; margin-bottom:4px;">
                    <i class="fa fa-exclamation-triangle"/> Dépassements de dotation
                </div>
                <table style="width:100%; border-collapse:collapse; background-color:#fff; font-size:10px;">
                    <thead>
                        <tr style="background-color:#f9d6d5;">
                            <th style="text-align:left; padding:4px 6px; border:1px solid #e6b0aa;">Engin</th>
                            <th style="text-align:right; padding:4px 6px; border:1px solid #e6b0aa; width:18%;">Dotation</th>
                            <th style="text-align:right; padding:4px 6px; border:1px solid #e6b0aa; width:18%;">Consommé</th>
                            <th style="text-align:right; padding:4px 6px; border:1px solid #e6b0aa; width:14%;">Taux</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="data['over_quota']" t-as="row">
                            <td style="padding:3px 6px; border:1px solid #d9d9d9;"><span t-esc="row['name']"/></td>
                            <td style="padding:3px 6px; border:1px solid #d9d9d9; text-align:right;">
                                <span t-esc="row['quota']" t-options="{'widget': 'float', 'precision': 2}"/>
                            </td>
                            <td style="padding:3px 6px; border:1px solid #d9d9d9; text-align:right;">
                                <span t-esc="row['quantity']" t-options="{'widget': 'float', 'precision': 2}"/>
                            </td>
                            <td style="padding:3px 6px; border:1px solid #d9d9d9; text-align:right; color:#c0392b; font-weight:bold;">
                                <span t-esc="row['rate']"/> %
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Répartitions -->
            <t t-call="ivorycocoa_secretariat.report_fuel_monthly_bucket">
                <t t-set="bucket_title" t-value="'Par carburant'"/>
                <t t-set="bucket_rows" t-value="data['by_fuel']"/>
            </t>
            <t t-call="ivorycocoa_secretariat.report_fuel_monthly_bucket">
                <t t-set="bucket_title" t-value="'Par engin'"/>
                <t t-set="bucket_rows" t-value="data['by_vehicle']"/>
            </t>
            <t t-call="ivorycocoa_secretariat.report_fuel_monthly_bucket">
                <t t-set="bucket_title" t-value="'Par bénéficiaire'"/>
                <t t-set="bucket_rows" t-value="data['by_beneficiary']"/>
            </t>

            <!-- Détail -->
            <div t-if="doc.include_detail" style="page-break-before:always;">
                <div style="font-size:12px; font-weight:bold; color:#305496; margin-bottom:4px;">
                    Détail des bons
                </div>
                <table style="width:100%; border-collapse:collapse; background-color:#fff; font-size:9px;">
                    <thead>
                        <tr style="background-color:#dce6f2;">
                            <th style="text-align:left; padding:3px 5px; border:1px solid #b8cce4;">N°</th>
                            <th style="text-align:left; padding:3px 5px; border:1px solid #b8cce4;">Date</th>
                            <th style="text-align:left; padding:3px 5px; border:1px solid #b8cce4;">Engin</th>
                            <th style="text-align:left; padding:3px 5px; border:1px solid #b8cce4;">Bénéficiaire</th>
                            <th style="text-align:left; padding:3px 5px; border:1px solid #b8cce4;">Carburant</th>
                            <th style="text-align:right; padding:3px 5px; border:1px solid #b8cce4;">P.U.</th>
                            <th style="text-align:right; padding:3px 5px; border:1px solid #b8cce4;">Qté</th>
                            <th style="text-align:right; padding:3px 5px; border:1px solid #b8cce4;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="data['vouchers']" t-as="voucher">
                            <td style="padding:2px 5px; border:1px solid #d9d9d9;"><span t-field="voucher.name"/></td>
                            <td style="padding:2px 5px; border:1px solid #d9d9d9;">
                                <span t-field="voucher.date" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                            </td>
                            <td style="padding:2px 5px; border:1px solid #d9d9d9;">
                                <span t-esc="voucher.vehicle_id.name or ''"/>
                            </td>
                            <td style="padding:2px 5px; border:1px solid #d9d9d9;">
                                <span t-esc="voucher.beneficiary_id.name or ''"/>
                            </td>
                            <td style="padding:2px 5px; border:1px solid #d9d9d9;">
                                <span t-esc="voucher.fuel_type_id.name or ''"/>
                            </td>
                            <td style="padding:2px 5px; border:1px solid #d9d9d9; text-align:right;">
                                <span t-esc="voucher.price_unit" t-options="{'widget': 'float', 'precision': 0}"/>
                            </td>
                            <td style="padding:2px 5px; border:1px solid #d9d9d9; text-align:right;">
                                <span t-esc="voucher.quantity" t-options="{'widget': 'float', 'precision': 2}"/>
                            </td>
                            <td style="padding:2px 5px; border:1px solid #d9d9d9; text-align:right;">
                                <span t-esc="voucher.amount_total"
                                      t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr style="background-color:#eef2f9; font-weight:bold;">
                            <td colspan="6" style="padding:3px 5px; border:1px solid #b8cce4;">TOTAL</td>
                            <td style="padding:3px 5px; border:1px solid #b8cce4; text-align:right;">
                                <span t-esc="data['quantity']" t-options="{'widget': 'float', 'precision': 2}"/>
                            </td>
                            <td style="padding:3px 5px; border:1px solid #b8cce4; text-align:right;">
                                <span t-esc="data['amount']"
                                      t-options="{'widget': 'monetary', 'display_currency': data['currency']}"/>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Signature -->
            <div style="margin-top:28px; width:45%; float:right; text-align:center; font-size:10px;">
                <div style="color:#555;">Établi par</div>
                <div style="font-weight:bold; margin-bottom:26px;"><span t-esc="doc.signatory or ''"/></div>
                <div style="border-top:1px solid #333; padding-top:3px; color:#555;">Signature</div>
            </div>
            <div style="clear:both;"/>
        </div>
    </template>

    <template id="report_fuel_monthly">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-call="ivorycocoa_secretariat.report_fuel_monthly_document"/>
                </t>
            </t>
        </t>
    </template>

</odoo>
