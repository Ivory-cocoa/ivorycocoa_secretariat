<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         BON DE CARBURANT — A5

         Contraintes wkhtmltopdf respectées ici :
         * pas d'emoji (aucune police emoji dans l'image Docker) — les
           pictogrammes sont des icônes FontAwesome ;
         * les tableaux portent un fond blanc explicite, faute de quoi le
           style des rapports Odoo les grise ;
         * les titres restent en éléments de bloc : « display:inline-block »
           se fait couper en deux lignes par wkhtmltopdf.
         ================================================================ -->
    <template id="report_fuel_voucher_document">
        <t t-set="company" t-value="doc.company_id"/>
        <div class="page" style="font-size:12px;">

            <!-- En-tête -->
            <div style="border-bottom:2px solid #305496; padding-bottom:6px; margin-bottom:10px;">
                <div style="float:right; text-align:right;">
                    <div style="font-size:10px; color:#666;">Bon n°</div>
                    <div style="font-size:22px; font-weight:bold; color:#305496;">
                        <span t-field="doc.name"/>
                    </div>
                </div>
                <div style="font-size:15px; font-weight:bold;">
                    <span t-field="company.name"/>
                </div>
                <div style="font-size:11px; color:#555;">
                    BON DE CARBURANT
                </div>
                <div style="clear:both;"/>
            </div>

            <!-- Corps -->
            <table style="width:100%; border-collapse:collapse; background-color:#fff;">
                <tr>
                    <td style="width:32%; padding:5px 4px; color:#555; border-bottom:1px solid #e0e0e0;">Date</td>
                    <td style="padding:5px 4px; font-weight:bold; border-bottom:1px solid #e0e0e0;">
                        <span t-field="doc.date" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                    </td>
                </tr>
                <tr>
                    <td style="padding:5px 4px; color:#555; border-bottom:1px solid #e0e0e0;">Engin</td>
                    <td style="padding:5px 4px; font-weight:bold; border-bottom:1px solid #e0e0e0;">
                        <span t-if="doc.vehicle_id" t-field="doc.vehicle_id.name"/>
                        <span t-else="" style="color:#999;">…………………………………</span>
                        <span t-if="doc.vehicle_id.license_plate" style="color:#666; font-weight:normal;">
                            (<span t-field="doc.vehicle_id.license_plate"/>)
                        </span>
                    </td>
                </tr>
                <tr>
                    <td style="padding:5px 4px; color:#555; border-bottom:1px solid #e0e0e0;">Bénéficiaire</td>
                    <td style="padding:5px 4px; font-weight:bold; border-bottom:1px solid #e0e0e0;">
                        <span t-if="doc.beneficiary_id" t-field="doc.beneficiary_id.name"/>
                        <span t-else="" style="color:#999;">…………………………………</span>
                    </td>
                </tr>
                <tr>
                    <td style="padding:5px 4px; color:#555; border-bottom:1px solid #e0e0e0;">Carburant</td>
                    <td style="padding:5px 4px; font-weight:bold; border-bottom:1px solid #e0e0e0;">
                        <span t-field="doc.fuel_type_id.name"/>
                    </td>
                </tr>
                <tr>
                    <td style="padding:5px 4px; color:#555; border-bottom:1px solid #e0e0e0;">Quantité</td>
                    <td style="padding:5px 4px; font-weight:bold; border-bottom:1px solid #e0e0e0;">
                        <span t-field="doc.quantity"/>
                        <span t-field="doc.uom_label"/>
                    </td>
                </tr>
                <tr>
                    <td style="padding:5px 4px; color:#555; border-bottom:1px solid #e0e0e0;">Prix unitaire</td>
                    <td style="padding:5px 4px; border-bottom:1px solid #e0e0e0;">
                        <span t-field="doc.price_unit"
                              t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                    </td>
                </tr>
                <tr t-if="doc.supplier_id">
                    <td style="padding:5px 4px; color:#555; border-bottom:1px solid #e0e0e0;">Station</td>
                    <td style="padding:5px 4px; border-bottom:1px solid #e0e0e0;">
                        <span t-field="doc.supplier_id.name"/>
                    </td>
                </tr>
            </table>

            <!-- Total -->
            <div style="margin-top:10px; background-color:#eef2f9; border:1px solid #305496; padding:8px;">
                <span style="font-size:13px; font-weight:bold; color:#305496;">TOTAL</span>
                <span style="float:right; font-size:16px; font-weight:bold;">
                    <span t-field="doc.amount_total"
                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                </span>
                <div style="clear:both;"/>
            </div>

            <div t-if="doc.note" style="margin-top:8px; font-size:10px; color:#555;">
                <i class="fa fa-info-circle"/>
                <span t-field="doc.note"/>
            </div>

            <div t-if="doc.state == 'cancelled'"
                 style="margin-top:8px; color:#c0392b; font-weight:bold;">
                <i class="fa fa-ban"/> BON ANNULÉ
            </div>

            <!-- Signatures -->
            <table style="width:100%; margin-top:26px; border-collapse:collapse; background-color:#fff;">
                <tr>
                    <td style="width:48%; text-align:center; font-size:10px; color:#555;">
                        <div style="border-top:1px solid #333; padding-top:3px;">Le secrétariat</div>
                    </td>
                    <td style="width:4%;"/>
                    <td style="width:48%; text-align:center; font-size:10px; color:#555;">
                        <div style="border-top:1px solid #333; padding-top:3px;">Le bénéficiaire</div>
                    </td>
                </tr>
            </table>

            <div style="margin-top:12px; font-size:8px; color:#999; text-align:center;">
                Édité le <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y à %H:%M')"/>
            </div>
        </div>
    </template>

    <template id="report_fuel_voucher">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <t t-call="ivorycocoa_secretariat.report_fuel_voucher_document"/>
            </t>
        </t>
    </template>

</odoo>
