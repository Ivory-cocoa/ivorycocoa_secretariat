<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         FORMAT DE PAGE — le bon de carburant tient sur une demi-page
         ================================================================ -->
    <record id="paperformat_fuel_voucher" model="report.paperformat">
        <field name="name">Bon de carburant (A5)</field>
        <field name="default" eval="False"/>
        <field name="format">A5</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">5</field>
        <field name="dpi">90</field>
    </record>

    <!-- ================================================================
         RAPPORTS
         ================================================================ -->
    <record id="action_report_fuel_voucher" model="ir.actions.report">
        <field name="name">Bon de carburant</field>
        <field name="model">secretariat.fuel.voucher</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ivorycocoa_secretariat.report_fuel_voucher</field>
        <field name="report_file">ivorycocoa_secretariat.report_fuel_voucher</field>
        <field name="print_report_name">'Bon %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="paperformat_fuel_voucher"/>
        <field name="binding_model_id" ref="model_secretariat_fuel_voucher"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_fuel_monthly" model="ir.actions.report">
        <field name="name">État récapitulatif des bons de carburant</field>
        <field name="model">secretariat.fuel.monthly.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ivorycocoa_secretariat.report_fuel_monthly</field>
        <field name="report_file">ivorycocoa_secretariat.report_fuel_monthly</field>
        <field name="print_report_name">'Carburant - %s' % (object._period_label())</field>
    </record>

</odoo>
