<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_secretariat" model="ir.module.category">
            <field name="name">Secrétariat</field>
            <field name="description">Outils du secrétariat de direction</field>
            <field name="sequence">55</field>
        </record>

        <!-- 1. Secrétaire — saisie quotidienne, import et export -->
        <record id="group_secretariat_user" model="res.groups">
            <field name="name">Secrétaire</field>
            <field name="comment">Secrétaire - Saisie des bons de carburant, import du classeur Excel et génération de l'export mensuel. Ne peut pas supprimer un bon ni modifier les référentiels de configuration.</field>
            <field name="category_id" ref="module_category_secretariat"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- 2. Responsable — configuration et suppression -->
        <record id="group_secretariat_manager" model="res.groups">
            <field name="name">Responsable du secrétariat</field>
            <field name="comment">Responsable du secrétariat - Tous les droits de la secrétaire, plus la configuration (types de carburant, engins, bénéficiaires) et la suppression des bons.</field>
            <field name="category_id" ref="module_category_secretariat"/>
            <field name="implied_ids" eval="[(4, ref('group_secretariat_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- ================================================================
             Règles multi-société
             ================================================================ -->
        <record id="secretariat_fuel_voucher_company_rule" model="ir.rule">
            <field name="name">Bons de carburant : multi-société</field>
            <field name="model_id" ref="model_secretariat_fuel_voucher"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
