<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ivorycocoa_secretariat.SecretariatDashboard" owl="1">
        <div t-attf-class="sec-dash #{state.loading ? 'sec-dash--loading' : ''}">

            <!-- ============================================================
                 COQUE — en-tête, période, actions rapides
                 ============================================================ -->
            <div class="sec-dash__header">
                <div class="sec-dash__title">
                    <i class="fa fa-briefcase"/>
                    <span>Secrétariat</span>
                    <small t-if="state.periodLabel" t-esc="state.periodLabel"/>
                </div>
                <div class="sec-dash__controls">
                    <select class="sec-dash__select" t-on-change="onPeriodChange"
                            aria-label="Période">
                        <option value="month" t-att-selected="state.period === 'month'">Ce mois-ci</option>
                        <option value="quarter" t-att-selected="state.period === 'quarter'">Ce trimestre</option>
                        <option value="year" t-att-selected="state.period === 'year'">Cette année</option>
                        <option value="last12" t-att-selected="state.period === 'last12'">12 derniers mois</option>
                        <option value="custom" t-att-selected="state.period === 'custom'">Période choisie</option>
                    </select>
                    <t t-if="state.period === 'custom'">
                        <input type="date" class="sec-dash__date" t-att-value="state.dateFrom"
                               t-on-change="onDateFromChange" aria-label="Du"/>
                        <input type="date" class="sec-dash__date" t-att-value="state.dateTo"
                               t-on-change="onDateToChange" aria-label="Au"/>
                    </t>
                    <button class="sec-dash__btn" t-on-click="loadData"
                            t-att-disabled="state.loading" title="Actualiser">
                        <i t-attf-class="fa fa-refresh #{state.loading ? 'fa-spin' : ''}"/>
                    </button>
                </div>
                <div class="sec-dash__progress" t-if="state.loading"/>
            </div>

            <div class="sec-dash__body">

                <!-- Actions rapides : ce que la secrétaire fait dix fois par jour -->
                <div class="sec-actions">
                    <button class="sec-action sec-action--primary" t-on-click="newVoucher">
                        <i class="fa fa-plus"/><span>Nouveau bon</span>
                    </button>
                    <button class="sec-action" t-on-click="quickEntry">
                        <i class="fa fa-list-ul"/><span>Saisie rapide</span>
                    </button>
                    <button class="sec-action" t-on-click="openImport">
                        <i class="fa fa-upload"/><span>Importer un classeur</span>
                    </button>
                    <button class="sec-action" t-on-click="openExport">
                        <i class="fa fa-file-excel-o"/><span>Exporter en Excel</span>
                    </button>
                    <button class="sec-action" t-on-click="openMonthlyReport">
                        <i class="fa fa-file-pdf-o"/><span>État mensuel</span>
                    </button>
                    <button class="sec-action" t-on-click="openAllVouchers">
                        <i class="fa fa-search"/><span>Tous les bons</span>
                    </button>
                </div>

                <!-- ========================================================
                     SECTION CARBURANT
                     ======================================================== -->
                <div class="sec-section">
                    <div class="sec-section__title">
                        <i class="fa fa-tint"/> Carburant
                    </div>

                    <!-- À traiter -->
                    <div class="sec-todo">
                        <div class="sec-todo__head">
                            <span t-if="hasTodo">
                                <i class="fa fa-exclamation-circle"/> À traiter
                            </span>
                            <span t-else="" class="sec-todo__clear">
                                <i class="fa fa-check-circle"/> Rien à traiter — le registre est à jour.
                            </span>
                        </div>
                        <div class="sec-todo__grid">
                            <button t-foreach="todoItems" t-as="item" t-key="item.key"
                                    t-attf-class="sec-todo__item sec-todo__item--#{item.level} #{item.count ? '' : 'sec-todo__item--empty'}"
                                    t-on-click="() => this.openTodo(item.key)"
                                    t-att-title="item.hint">
                                <i t-attf-class="fa #{item.icon}"/>
                                <span class="sec-todo__count" t-esc="formatNumber(item.count)"/>
                                <span class="sec-todo__label" t-esc="item.label"/>
                            </button>
                        </div>
                    </div>

                    <!-- KPI de la période -->
                    <div class="sec-kpis">
                        <div class="sec-kpi">
                            <div class="sec-kpi__label">Bons</div>
                            <div class="sec-kpi__value" t-esc="formatNumber(state.fuel.stats.voucher_count)"/>
                            <div t-attf-class="sec-delta #{deltaClass(state.fuel.stats.count_delta)}">
                                <t t-esc="deltaLabel(state.fuel.stats.count_delta)"/>
                                <span class="sec-delta__ref" t-if="state.previousLabel">
                                    vs <t t-esc="state.previousLabel"/>
                                </span>
                            </div>
                        </div>
                        <div class="sec-kpi">
                            <div class="sec-kpi__label">Quantité servie</div>
                            <div class="sec-kpi__value" t-esc="formatNumber(state.fuel.stats.quantity, 2)"/>
                            <div t-attf-class="sec-delta #{deltaClass(state.fuel.stats.quantity_delta)}">
                                <t t-esc="deltaLabel(state.fuel.stats.quantity_delta)"/>
                            </div>
                        </div>
                        <div class="sec-kpi sec-kpi--accent">
                            <div class="sec-kpi__label">Montant</div>
                            <div class="sec-kpi__value" t-esc="formatAmount(state.fuel.stats.amount)"/>
                            <div t-attf-class="sec-delta #{deltaClass(state.fuel.stats.amount_delta)}">
                                <t t-esc="deltaLabel(state.fuel.stats.amount_delta)"/>
                            </div>
                        </div>
                        <div class="sec-kpi">
                            <div class="sec-kpi__label">Cumul de l'année</div>
                            <div class="sec-kpi__value" t-esc="formatAmount(state.fuel.stats.ytd_amount)"/>
                            <div class="sec-delta sec-delta--flat">
                                <t t-esc="formatNumber(state.fuel.stats.ytd_count)"/> bons depuis le 1<sup>er</sup> janvier
                            </div>
                        </div>
                        <div class="sec-kpi">
                            <div class="sec-kpi__label">Bon moyen</div>
                            <div class="sec-kpi__value" t-esc="formatAmount(state.fuel.stats.average_amount)"/>
                            <div class="sec-delta sec-delta--flat">sur la période</div>
                        </div>
                    </div>

                    <!-- Graphiques -->
                    <div class="sec-grid sec-grid--charts" t-if="state.chartsAvailable">
                        <div class="sec-card sec-card--wide">
                            <div class="sec-card__title">Douze derniers mois</div>
                            <div class="sec-card__chart">
                                <canvas t-ref="trendChart" t-if="state.fuel.monthly_trend.length"/>
                                <div class="sec-empty" t-else="">Aucun bon sur la période.</div>
                            </div>
                        </div>
                        <div class="sec-card">
                            <div class="sec-card__title">Répartition par carburant</div>
                            <div class="sec-card__chart">
                                <canvas t-ref="fuelChart" t-if="state.fuel.fuel_split.length"/>
                                <div class="sec-empty" t-else="">Aucun bon sur la période.</div>
                            </div>
                        </div>
                    </div>

                    <!-- Palmarès -->
                    <div class="sec-grid">
                        <div class="sec-card">
                            <div class="sec-card__title">Engins les plus servis</div>
                            <div class="sec-card__body">
                                <div class="sec-rank" t-foreach="state.fuel.top_vehicles" t-as="row"
                                     t-key="row.id" t-on-click="() => this.openVehicle(row.id)">
                                    <div class="sec-rank__head">
                                        <span class="sec-rank__name" t-esc="row.name"/>
                                        <span class="sec-rank__value" t-esc="formatAmount(row.amount)"/>
                                    </div>
                                    <div class="sec-rank__bar">
                                        <div class="sec-rank__fill"
                                             t-attf-style="width: #{barWidth(row.amount, state.fuel.top_vehicles)}%"/>
                                    </div>
                                    <div class="sec-rank__sub">
                                        <t t-esc="formatNumber(row.quantity, 2)"/> servis
                                        · <t t-esc="row.count"/> bon(s)
                                        <span t-if="row.monthly_quota">
                                            · dotation <t t-esc="formatNumber(row.monthly_quota, 2)"/>
                                        </span>
                                    </div>
                                </div>
                                <div class="sec-empty" t-if="!state.fuel.top_vehicles.length">
                                    Aucun bon sur la période.
                                </div>
                            </div>
                        </div>

                        <div class="sec-card">
                            <div class="sec-card__title">Bénéficiaires les plus servis</div>
                            <div class="sec-card__body">
                                <div class="sec-rank" t-foreach="state.fuel.top_beneficiaries" t-as="row"
                                     t-key="row.id" t-on-click="() => this.openBeneficiary(row.id)">
                                    <div class="sec-rank__head">
                                        <span class="sec-rank__name" t-esc="row.name"/>
                                        <span class="sec-rank__value" t-esc="formatAmount(row.amount)"/>
                                    </div>
                                    <div class="sec-rank__bar">
                                        <div class="sec-rank__fill sec-rank__fill--alt"
                                             t-attf-style="width: #{barWidth(row.amount, state.fuel.top_beneficiaries)}%"/>
                                    </div>
                                    <div class="sec-rank__sub">
                                        <t t-esc="formatNumber(row.quantity, 2)"/> servis
                                        · <t t-esc="row.count"/> bon(s)
                                    </div>
                                </div>
                                <div class="sec-empty" t-if="!state.fuel.top_beneficiaries.length">
                                    Aucun bon sur la période.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Dotations et anomalies -->
                    <div class="sec-grid">
                        <div class="sec-card">
                            <div class="sec-card__title">
                                Dotations du mois
                                <small>consommation rapportée au plafond</small>
                            </div>
                            <div class="sec-card__body">
                                <div class="sec-quota" t-foreach="state.fuel.quota_watch" t-as="row"
                                     t-key="row.id" t-on-click="() => this.openVehicle(row.id)">
                                    <div class="sec-quota__head">
                                        <span t-esc="row.name"/>
                                        <strong t-esc="formatNumber(row.usage_rate, 1) + ' %'"/>
                                    </div>
                                    <div class="sec-quota__bar">
                                        <div t-attf-class="sec-quota__fill #{quotaClass(row.usage_rate)}"
                                             t-attf-style="width: #{Math.min(100, row.usage_rate)}%"/>
                                    </div>
                                    <div class="sec-quota__sub">
                                        <t t-esc="formatNumber(row.quantity, 2)"/>
                                        <t t-if="row.monthly_quota"> sur <t t-esc="formatNumber(row.monthly_quota, 2)"/></t>
                                        <t t-if="row.monthly_budget">
                                            · <t t-esc="formatAmount(row.amount)"/> sur <t t-esc="formatAmount(row.monthly_budget)"/>
                                        </t>
                                    </div>
                                </div>
                                <div class="sec-empty" t-if="!state.fuel.quota_watch.length">
                                    Aucune dotation mensuelle définie. Renseignez-la sur la
                                    fiche d'un engin pour suivre ses dépassements.
                                </div>
                            </div>
                        </div>

                        <div class="sec-card">
                            <div class="sec-card__title">
                                Consommations inhabituelles
                                <small>ce mois-ci, comparé à l'habitude de l'engin</small>
                            </div>
                            <div class="sec-card__body">
                                <div class="sec-anomaly" t-foreach="state.fuel.anomalies" t-as="row"
                                     t-key="row.id" t-on-click="() => this.openVehicle(row.id)">
                                    <div class="sec-anomaly__icon"><i class="fa fa-line-chart"/></div>
                                    <div class="sec-anomaly__body">
                                        <div class="sec-anomaly__name" t-esc="row.name"/>
                                        <div class="sec-anomaly__detail">
                                            <t t-esc="formatNumber(row.quantity, 2)"/> ce mois-ci,
                                            contre <t t-esc="formatNumber(row.average, 2)"/> en moyenne
                                            sur <t t-esc="row.months"/> mois
                                        </div>
                                    </div>
                                    <div class="sec-anomaly__delta">
                                        +<t t-esc="formatNumber(row.deviation, 0)"/> %
                                    </div>
                                </div>
                                <div class="sec-empty" t-if="!state.fuel.anomalies.length">
                                    Rien d'inhabituel. Un engin n'est signalé qu'au-delà de
                                    1,5 fois sa consommation moyenne, et seulement s'il a
                                    au moins deux mois d'historique.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Derniers bons et tarifs -->
                    <div class="sec-grid sec-grid--charts">
                        <div class="sec-card sec-card--wide">
                            <div class="sec-card__title">Derniers bons enregistrés</div>
                            <div class="sec-card__body sec-card__body--flush">
                                <table class="sec-table">
                                    <thead>
                                        <tr>
                                            <th>N°</th><th>Date</th><th>Engin</th>
                                            <th>Bénéficiaire</th><th>Carburant</th>
                                            <th class="sec-num">Quantité</th>
                                            <th class="sec-num">Montant</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.fuel.recent" t-as="row" t-key="row.id"
                                            t-on-click="() => this.openVoucher(row.id)"
                                            t-attf-class="#{row.incomplete ? 'sec-table__row--warn' : ''}">
                                            <td><strong t-esc="row.name"/></td>
                                            <td t-esc="row.date_label"/>
                                            <td t-esc="row.vehicle || '—'"/>
                                            <td t-esc="row.beneficiary || '—'"/>
                                            <td t-esc="row.fuel"/>
                                            <td class="sec-num" t-esc="formatNumber(row.quantity, 2)"/>
                                            <td class="sec-num" t-esc="formatAmount(row.amount)"/>
                                        </tr>
                                    </tbody>
                                </table>
                                <div class="sec-empty" t-if="!state.fuel.recent.length">
                                    Aucun bon enregistré pour l'instant.
                                </div>
                            </div>
                        </div>

                        <div class="sec-card">
                            <div class="sec-card__title">
                                Tarifs courants
                                <small>appliqués par défaut à la saisie</small>
                            </div>
                            <div class="sec-card__body">
                                <div class="sec-price" t-foreach="state.fuel.price_reference"
                                     t-as="row" t-key="row.id">
                                    <span class="sec-price__name" t-esc="row.name"/>
                                    <span class="sec-price__value">
                                        <t t-esc="formatAmount(row.price)"/>
                                        <small t-if="row.uom"> / <t t-esc="row.uom"/></small>
                                    </span>
                                </div>
                                <div class="sec-empty" t-if="!state.fuel.price_reference.length">
                                    Aucun type de carburant configuré.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
