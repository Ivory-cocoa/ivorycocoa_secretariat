<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_secretariat_beneficiary_tree" model="ir.ui.view">
        <field name="name">secretariat.fuel.beneficiary.tree</field>
        <field name="model">secretariat.fuel.beneficiary</field>
        <field name="arch" type="xml">
            <tree string="Bénéficiaires" sample="1">
                <field name="currency_id" column_invisible="1"/>
                <field name="name"/>
                <field name="category" optional="show"/>
                <field name="employee_id" optional="show"/>
                <field name="voucher_count" string="Bons"/>
                <field name="last_voucher_date" string="Dernier bon" optional="show"/>
                <field name="quantity_total" string="Quantité totale" optional="hide"/>
                <field name="amount_total" string="Montant total" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_secretariat_beneficiary_form" model="ir.ui.view">
        <field name="name">secretariat.fuel.beneficiary.form</field>
        <field name="model">secretariat.fuel.beneficiary</field>
        <field name="arch" type="xml">
            <form string="Bénéficiaire">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vouchers" type="object"
                                class="oe_stat_button" icon="fa-ticket">
                            <field name="voucher_count" widget="statinfo" string="Bons"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ex. Camara, Usine, Douanes…"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="employee_id"
                                   invisible="category != 'employee'"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="last_voucher_date" readonly="1"/>
                            <field name="active" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="normalized_name" groups="base.group_no_one"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_secretariat_beneficiary_search" model="ir.ui.view">
        <field name="name">secretariat.fuel.beneficiary.search</field>
        <field name="model">secretariat.fuel.beneficiary</field>
        <field name="arch" type="xml">
            <search string="Bénéficiaires">
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="filter_employee" string="Employés"
                        domain="[('category', '=', 'employee')]"/>
                <filter name="filter_department" string="Services internes"
                        domain="[('category', '=', 'department')]"/>
                <filter name="filter_external" string="Tiers"
                        domain="[('category', '=', 'external')]"/>
                <separator/>
                <filter name="filter_unlinked" string="Sans fiche employé"
                        domain="[('category', '=', 'employee'), ('employee_id', '=', False)]"/>
                <filter name="groupby_category" string="Catégorie"
                        context="{'group_by': 'category'}"/>
            </search>
        </field>
    </record>

    <record id="action_secretariat_beneficiary" model="ir.actions.act_window">
        <field name="name">Bénéficiaires</field>
        <field name="res_model">secretariat.fuel.beneficiary</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_secretariat_beneficiary_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ajoutez un bénéficiaire
            </p>
            <p>
                Employés, services internes (Usine, Personnel) ou organismes
                extérieurs (Douanes, CCC) au nom desquels les bons sont émis.
            </p>
        </field>
    </record>

</odoo>
