<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         PARAMÈTRES → SECRÉTARIAT

         Même stockage et mêmes contrôles que l'assistant « Paramètres du
         secrétariat » (réservé, lui, au responsable qui n'a pas les droits
         d'administration). Voir models/secretariat_config_settings.py.
         ================================================================ -->
    <record id="res_config_settings_view_form_secretariat" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.secretariat</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Secrétariat" name="ivorycocoa_secretariat"
                     logo="/ivorycocoa_secretariat/static/description/icon.png">

                    <block title="Bons de carburant" name="secretariat_voucher_block">
                        <setting id="secretariat_voucher_numbering"
                                 string="Numérotation des bons"
                                 help="Le numéro est proposé à la création et reste modifiable : c'est la souche papier qui fait foi. Le compteur se recale automatiquement au-dessus du plus grand numéro utilisé.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="secretariat_voucher_start_number"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="secretariat_voucher_start_number"/>
                                </div>
                                <div class="row">
                                    <label for="secretariat_voucher_padding"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="secretariat_voucher_padding"/>
                                </div>
                                <div class="row">
                                    <label for="secretariat_voucher_highest_number"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="secretariat_voucher_highest_number"
                                           readonly="1"/>
                                </div>
                                <div class="text-muted mt8">
                                    Un numéro de départ inférieur au plus grand
                                    numéro enregistré reproposera des numéros
                                    déjà servis. Ce n'est pas interdit — un
                                    nouveau carnet peut recommencer plus bas —
                                    mais mieux vaut le décider en connaissance
                                    de cause.
                                </div>
                            </div>
                        </setting>

                        <setting id="secretariat_default_station"
                                 string="Station-service par défaut"
                                 help="Proposée d'office à la saisie d'un bon, et utilisée pour rattacher les bons sans station au moment de la facturation de la quinzaine.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <field name="secretariat_fuel_station_id"
                                           options="{'no_create_edit': True}"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Suivi de l'utilisation des bons"
                           name="secretariat_usage_block">
                        <setting id="secretariat_usage_thresholds"
                                 string="Seuils de délai d'utilisation"
                                 help="Écart entre l'émission d'un bon et son utilisation. Ces seuils n'interdisent rien : ils alimentent les statistiques, les alertes et les recommandations du tableau de bord.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="secretariat_usage_alert_days"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="secretariat_usage_alert_days"/>
                                </div>
                                <div class="row">
                                    <label for="secretariat_usage_critical_days"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="secretariat_usage_critical_days"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_secretariat_config_settings" model="ir.actions.act_window">
        <field name="name">Paramètres</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'ivorycocoa_secretariat'}</field>
    </record>

</odoo>
