<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         LISTE
         ================================================================ -->
    <record id="view_secretariat_fuel_invoice_tree" model="ir.ui.view">
        <field name="name">secretariat.fuel.invoice.tree</field>
        <field name="model">secretariat.fuel.invoice</field>
        <field name="arch" type="xml">
            <tree string="Factures de stations" sample="1"
                  decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'draft'"
                  decoration-danger="has_difference and state != 'cancelled'"
                  default_order="date_to desc, id desc">
                <header>
                    <button name="action_confirm" type="object"
                            string="Valider" class="btn-primary"/>
                    <button name="action_mark_paid" type="object" string="Marquer payée"/>
                </header>
                <field name="currency_id" column_invisible="1"/>
                <field name="has_difference" column_invisible="1"/>
                <field name="name"/>
                <field name="station_id"/>
                <field name="period_label" string="Quinzaine"/>
                <field name="voucher_count" string="Bons" sum="Bons"/>
                <field name="quantity_total" optional="hide" sum="Quantité"/>
                <field name="amount_total" widget="monetary" sum="Total des bons"/>
                <field name="statement_amount" widget="monetary" optional="show"
                       sum="Montant réclamé"/>
                <field name="amount_difference" widget="monetary" optional="show"
                       sum="Écart"/>
                <field name="date_due" optional="hide"/>
                <field name="payment_date" optional="hide"/>
                <field name="station_invoice_ref" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- ================================================================
         FORMULAIRE
         ================================================================ -->
    <record id="view_secretariat_fuel_invoice_form" model="ir.ui.view">
        <field name="name">secretariat.fuel.invoice.form</field>
        <field name="model">secretariat.fuel.invoice</field>
        <field name="arch" type="xml">
            <form string="Facture de station">
                <header>
                    <button name="action_collect_vouchers" type="object"
                            string="Récupérer les bons de la quinzaine"
                            class="btn-primary" icon="fa-download"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" type="object" string="Valider"
                            class="btn-primary" invisible="state != 'draft' or voucher_count == 0"/>
                    <button name="action_mark_paid" type="object"
                            string="Marquer payée" class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_print" type="object" string="Imprimer"
                            icon="fa-print" invisible="state == 'cancelled'"/>
                    <button name="action_unpay" type="object"
                            string="Annuler le paiement" invisible="state != 'paid'"/>
                    <button name="action_draft" type="object"
                            string="Remettre en brouillon"
                            invisible="state in ('draft', 'paid')"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state in ('cancelled', 'paid')"
                            confirm="Les bons repris seront rendus à la facturation. Continuer ?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vouchers" type="object"
                                class="oe_stat_button" icon="fa-list-ul">
                            <field name="voucher_count" widget="statinfo"
                                   string="Bons facturés"/>
                        </button>
                        <button name="action_view_candidates" type="object"
                                class="oe_stat_button" icon="fa-search"
                                invisible="state != 'draft'">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Bons</span>
                                <span class="o_stat_text">facturables</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Facture"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="alert alert-danger" role="alert"
                         invisible="not has_difference">
                        <i class="fa fa-balance-scale"/>
                        Le montant réclamé par la station diffère du total des
                        bons enregistrés de
                        <field name="amount_difference" widget="monetary"
                               class="oe_inline" readonly="1"/>.
                        Cherchez d'abord un bon oublié à la saisie, puis un bon
                        servi hors quinzaine. Cet écart devra être expliqué
                        pour valider la facture.
                    </div>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'draft' or voucher_count != 0">
                        <i class="fa fa-info-circle"/>
                        Cette facture ne reprend encore aucun bon. Cliquez sur
                        <b>Récupérer les bons de la quinzaine</b> : tous les
                        bons de cette station servis sur la période y seront
                        ajoutés.
                    </div>

                    <group>
                        <group string="Station et période">
                            <field name="station_id"
                                   options="{'no_create_edit': True}"
                                   readonly="state != 'draft'"/>
                            <label for="period_year" string="Quinzaine"/>
                            <div class="o_row">
                                <field name="period_half" class="oe_inline"
                                       readonly="state != 'draft'" nolabel="1"/>
                                <field name="period_month" class="oe_inline"
                                       readonly="state != 'draft'" nolabel="1"/>
                                <field name="period_year" class="oe_inline"
                                       readonly="state != 'draft'" nolabel="1"/>
                            </div>
                            <label for="date_from" string="Période couverte"/>
                            <div class="o_row">
                                <field name="date_from" readonly="1" class="oe_inline"/>
                                <span class="mx-1">→</span>
                                <field name="date_to" readonly="1" class="oe_inline"/>
                            </div>
                            <field name="period_label" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="has_difference" invisible="1"/>
                        </group>
                        <group string="Relevé de la station">
                            <field name="station_invoice_ref"
                                   placeholder="N° porté sur la facture de la station"/>
                            <field name="station_invoice_date"/>
                            <field name="date_due"/>
                            <field name="statement_amount" widget="monetary"
                                   readonly="state in ('paid', 'cancelled')"/>
                            <field name="amount_difference" widget="monetary"
                                   readonly="1" invisible="not has_difference"/>
                        </group>
                    </group>

                    <group string="Explication de l'écart" invisible="not has_difference">
                        <field name="difference_reason" nolabel="1"
                               placeholder="Bon oublié à la saisie, bon servi hors quinzaine, erreur de la station…"/>
                    </group>

                    <notebook>
                        <page string="Bons repris" name="vouchers">
                            <field name="voucher_ids" nolabel="1" readonly="1">
                                <tree editable="false" create="false" delete="false"
                                      decoration-muted="state == 'cancelled'">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="name" string="N° bon"/>
                                    <field name="date" string="Émis le"/>
                                    <field name="date_used" string="Utilisé le"/>
                                    <field name="vehicle_id"/>
                                    <field name="beneficiary_id"/>
                                    <field name="fuel_type_id"/>
                                    <field name="quantity" sum="Quantité"/>
                                    <field name="amount_total" widget="monetary" sum="Total"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'confirmed'"
                                           decoration-info="state == 'draft'"/>
                                    <button name="action_detach_invoice" type="object"
                                            icon="fa-times" title="Retirer de la facture"
                                            invisible="parent.state != 'draft'"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="quantity_total"/>
                                <field name="amount_total" widget="monetary"
                                       class="oe_subtotal_footer_separator"/>
                                <field name="statement_amount" widget="monetary"
                                       invisible="not statement_amount"/>
                                <field name="amount_difference" widget="monetary"
                                       invisible="not has_difference"/>
                            </group>
                        </page>
                        <page string="Règlement" name="payment"
                              invisible="state == 'draft'">
                            <group>
                                <group>
                                    <field name="payment_date"/>
                                    <field name="payment_reference"
                                           placeholder="N° de chèque, d'ordre de virement…"
                                           readonly="state == 'cancelled'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Observations" name="note">
                            <field name="note" nolabel="1"
                                   placeholder="Notes internes…"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ================================================================
         RECHERCHE
         ================================================================ -->
    <record id="view_secretariat_fuel_invoice_search" model="ir.ui.view">
        <field name="name">secretariat.fuel.invoice.search</field>
        <field name="model">secretariat.fuel.invoice</field>
        <field name="arch" type="xml">
            <search string="Factures de stations">
                <field name="name"/>
                <field name="station_id"/>
                <field name="station_invoice_ref" string="N° facture station"/>
                <field name="payment_reference" string="Référence du règlement"/>

                <filter name="filter_draft" string="Brouillons"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_to_pay" string="À payer"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_paid" string="Payées"
                        domain="[('state', '=', 'paid')]"/>
                <filter name="filter_cancelled" string="Annulées"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_difference" string="Avec écart"
                        domain="[('has_difference', '=', True), ('state', '!=', 'cancelled')]"/>
                <filter name="filter_overdue" string="En retard de paiement"
                        domain="[('state', '=', 'confirmed'), ('date_due', '!=', False),
                                 ('date_due', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_this_year" string="Cette année"
                        domain="[('date_to', '&gt;=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_this_month" string="Ce mois-ci"
                        domain="[('date_to', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="groupby_station" string="Station"
                        context="{'group_by': 'station_id'}"/>
                <filter name="groupby_month" string="Mois"
                        context="{'group_by': 'date_to:month'}"/>
                <filter name="groupby_half" string="Quinzaine"
                        context="{'group_by': 'period_half'}"/>
                <filter name="groupby_state" string="État"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ================================================================
         ANALYSE
         ================================================================ -->
    <record id="view_secretariat_fuel_invoice_pivot" model="ir.ui.view">
        <field name="name">secretariat.fuel.invoice.pivot</field>
        <field name="model">secretariat.fuel.invoice</field>
        <field name="arch" type="xml">
            <pivot string="Factures de stations" sample="1">
                <field name="date_to" interval="month" type="col"/>
                <field name="station_id" type="row"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_secretariat_fuel_invoice_graph" model="ir.ui.view">
        <field name="name">secretariat.fuel.invoice.graph</field>
        <field name="model">secretariat.fuel.invoice</field>
        <field name="arch" type="xml">
            <graph string="Factures de stations" type="bar" sample="1">
                <field name="date_to" interval="month"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ================================================================
         ACTIONS
         ================================================================ -->
    <record id="action_secretariat_fuel_invoice" model="ir.actions.act_window">
        <field name="name">Factures de stations</field>
        <field name="res_model">secretariat.fuel.invoice</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="search_view_id" ref="view_secretariat_fuel_invoice_search"/>
        <field name="context">{'search_default_filter_this_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune facture de station
            </p>
            <p>
                Une facture regroupe les bons d'une station sur une quinzaine
                (du 1er au 15, puis du 16 à la fin du mois). Le plus simple est
                de passer par <b>Facturation → Générer les factures de la
                quinzaine</b> : une facture par station, prête à être
                confrontée au relevé remis par la station.
            </p>
        </field>
    </record>

    <record id="action_secretariat_fuel_invoice_to_pay" model="ir.actions.act_window">
        <field name="name">Factures à payer</field>
        <field name="res_model">secretariat.fuel.invoice</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_secretariat_fuel_invoice_search"/>
        <field name="domain">[('state', '=', 'confirmed')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune facture en attente de paiement
            </p>
            <p>
                Les factures validées apparaissent ici jusqu'à leur règlement.
            </p>
        </field>
    </record>

</odoo>
