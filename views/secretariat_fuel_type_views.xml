<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_secretariat_fuel_type_tree" model="ir.ui.view">
        <field name="name">secretariat.fuel.type.tree</field>
        <field name="model">secretariat.fuel.type</field>
        <field name="arch" type="xml">
            <tree string="Types de carburant" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="uom_label"/>
                <field name="price"/>
                <field name="voucher_count" string="Bons"/>
                <field name="active" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_secretariat_fuel_type_form" model="ir.ui.view">
        <field name="name">secretariat.fuel.type.form</field>
        <field name="model">secretariat.fuel.type</field>
        <field name="arch" type="xml">
            <form string="Type de carburant">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vouchers" type="object"
                                class="oe_stat_button" icon="fa-ticket">
                            <field name="voucher_count" widget="statinfo" string="Bons"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ex. Super"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="uom_label"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                            <field name="normalized_name" groups="base.group_no_one"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_secretariat_fuel_type" model="ir.actions.act_window">
        <field name="name">Types de carburant</field>
        <field name="res_model">secretariat.fuel.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ajoutez un type de carburant
            </p>
            <p>
                Le prix renseigné ici est proposé par défaut sur les nouveaux
                bons ; les bons déjà enregistrés conservent leur propre prix.
            </p>
        </field>
    </record>

</odoo>
