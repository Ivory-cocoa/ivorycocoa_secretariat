<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         LISTE — consultation (édition multiple)
         ================================================================ -->
    <record id="view_secretariat_fuel_voucher_tree" model="ir.ui.view">
        <field name="name">secretariat.fuel.voucher.tree</field>
        <field name="model">secretariat.fuel.voucher</field>
        <field name="arch" type="xml">
            <tree string="Bons de carburant"
                  multi_edit="1"
                  sample="1"
                  decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'draft'"
                  decoration-warning="is_incomplete and state != 'cancelled'"
                  default_order="date desc, id desc">
                <header>
                    <button name="action_confirm" type="object"
                            string="Valider" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Annuler"/>
                </header>
                <field name="company_id" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_incomplete" column_invisible="1"/>
                <field name="name" string="N° bon"/>
                <field name="date"/>
                <field name="vehicle_id" optional="show"/>
                <field name="beneficiary_id" optional="show"/>
                <field name="fuel_type_id" optional="show"/>
                <field name="price_unit" optional="show"/>
                <field name="quantity" sum="Total quantité"/>
                <field name="uom_label" optional="hide"/>
                <field name="amount_total" sum="Total" widget="monetary"/>
                <field name="supplier_id" optional="hide"/>
                <field name="imported" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-info="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- ================================================================
         LISTE — saisie à la chaîne
         La secrétaire recopie un carnet papier : elle doit enchaîner les
         lignes sans ouvrir un formulaire à chaque bon. D'où une seconde
         vue liste, éditable (incompatible avec multi_edit, qui reste sur
         la vue de consultation ci-dessus).
         ================================================================ -->
    <record id="view_secretariat_fuel_voucher_tree_quick" model="ir.ui.view">
        <field name="name">secretariat.fuel.voucher.tree.quick</field>
        <field name="model">secretariat.fuel.voucher</field>
        <field name="arch" type="xml">
            <tree string="Saisie des bons"
                  editable="bottom"
                  sample="1"
                  decoration-warning="is_incomplete and state != 'cancelled'"
                  decoration-muted="state == 'cancelled'"
                  default_order="date desc, id desc">
                <field name="currency_id" column_invisible="1"/>
                <field name="is_incomplete" column_invisible="1"/>
                <field name="name" string="N° bon"/>
                <field name="date"/>
                <field name="vehicle_id" options="{'no_open': True}"/>
                <field name="beneficiary_id" options="{'no_open': True}"/>
                <field name="fuel_type_id" options="{'no_open': True, 'no_create': True}"/>
                <field name="price_unit"/>
                <field name="quantity" sum="Total quantité"/>
                <field name="amount_total" sum="Total" widget="monetary" readonly="1"/>
                <field name="state" widget="badge" optional="show"
                       decoration-success="state == 'confirmed'"
                       decoration-info="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- ================================================================
         KANBAN — consultation sur tablette
         ================================================================ -->
    <record id="view_secretariat_fuel_voucher_kanban" model="ir.ui.view">
        <field name="name">secretariat.fuel.voucher.kanban</field>
        <field name="model">secretariat.fuel.voucher</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1" default_order="date desc, id desc">
                <field name="currency_id"/>
                <field name="is_incomplete"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_secretariat_voucher_card">
                            <div class="o_kanban_record_top mb-0">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        Bon n° <field name="name"/>
                                    </strong>
                                    <span class="o_kanban_record_subtitle text-muted">
                                        <field name="vehicle_id"/>
                                    </span>
                                </div>
                                <field name="date" class="text-muted small"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <span class="me-2"><field name="fuel_type_id"/></span>
                                <span class="me-2"><field name="quantity"/></span>
                                <strong><field name="amount_total" widget="monetary"/></strong>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left text-muted">
                                    <field name="beneficiary_id"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span class="badge text-bg-warning me-1" invisible="not is_incomplete">
                                        À compléter
                                    </span>
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'draft': 'info', 'confirmed': 'success', 'cancelled': 'danger'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ================================================================
         FORMULAIRE
         ================================================================ -->
    <record id="view_secretariat_fuel_voucher_form" model="ir.ui.view">
        <field name="name">secretariat.fuel.voucher.form</field>
        <field name="model">secretariat.fuel.voucher</field>
        <field name="arch" type="xml">
            <form string="Bon de carburant">
                <header>
                    <button name="action_confirm" type="object" string="Valider"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print" type="object" string="Imprimer"
                            icon="fa-print" invisible="state == 'cancelled'"/>
                    <button name="action_cancel" type="object" string="Annuler"
                            invisible="state == 'cancelled'"/>
                    <button name="action_draft" type="object"
                            string="Remettre en brouillon"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Bon n°"/>
                        <h1><field name="name" placeholder="Ex. 6275"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not is_incomplete">
                        Ce bon est incomplet : il lui manque un engin, un
                        bénéficiaire, un prix ou une quantité. Complétez-le
                        pour fiabiliser les statistiques.
                    </div>
                    <group>
                        <group string="Bon">
                            <field name="date"/>
                            <field name="vehicle_id"
                                   options="{'no_quick_create': True}"/>
                            <field name="beneficiary_id"
                                   options="{'no_quick_create': True}"/>
                            <field name="supplier_id"
                                   options="{'no_create_edit': True}"/>
                        </group>
                        <group string="Carburant">
                            <field name="fuel_type_id"
                                   options="{'no_quick_create': True}"/>
                            <field name="price_unit"/>
                            <label for="quantity"/>
                            <div class="o_row">
                                <field name="quantity" class="oe_inline"/>
                                <field name="uom_label" class="oe_inline" readonly="1" nolabel="1"/>
                            </div>
                            <field name="amount_total" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="is_incomplete" invisible="1"/>
                        </group>
                    </group>
                    <group string="Observations">
                        <field name="note" nolabel="1" placeholder="Notes internes…"/>
                    </group>
                    <group string="Origine" invisible="not imported">
                        <field name="imported"/>
                        <field name="import_source"/>
                    </group>
                    <field name="company_id" groups="base.group_multi_company"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ================================================================
         RECHERCHE
         ================================================================ -->
    <record id="view_secretariat_fuel_voucher_search" model="ir.ui.view">
        <field name="name">secretariat.fuel.voucher.search</field>
        <field name="model">secretariat.fuel.voucher</field>
        <field name="arch" type="xml">
            <search string="Bons de carburant">
                <field name="name" string="N° de bon"/>
                <field name="vehicle_id"/>
                <field name="beneficiary_id"/>
                <field name="fuel_type_id"/>
                <field name="supplier_id"/>
                <field name="note" string="Observations"/>

                <filter name="filter_draft" string="Brouillons"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Validés"
                        domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_cancelled" string="Annulés"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="filter_incomplete" string="À compléter"
                        domain="[('is_incomplete', '=', True), ('state', '!=', 'cancelled')]"/>
                <filter name="filter_future" string="Datés dans le futur"
                        domain="[('date', '&gt;', context_today().strftime('%Y-%m-%d')), ('state', '!=', 'cancelled')]"/>
                <filter name="filter_imported" string="Issus de l'import"
                        domain="[('imported', '=', True)]"/>
                <separator/>
                <filter name="filter_today" string="Aujourd'hui"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_this_month" string="Ce mois-ci"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_this_year" string="Cette année"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="groupby_date" string="Mois" context="{'group_by': 'date:month'}"/>
                <filter name="groupby_vehicle" string="Engin" context="{'group_by': 'vehicle_id'}"/>
                <filter name="groupby_beneficiary" string="Bénéficiaire" context="{'group_by': 'beneficiary_id'}"/>
                <filter name="groupby_fuel" string="Carburant" context="{'group_by': 'fuel_type_id'}"/>
                <filter name="groupby_supplier" string="Station" context="{'group_by': 'supplier_id'}"/>
                <filter name="groupby_state" string="État" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ================================================================
         ANALYSE
         ================================================================ -->
    <record id="view_secretariat_fuel_voucher_pivot" model="ir.ui.view">
        <field name="name">secretariat.fuel.voucher.pivot</field>
        <field name="model">secretariat.fuel.voucher</field>
        <field name="arch" type="xml">
            <pivot string="Consommation de carburant" sample="1">
                <field name="date" interval="month" type="col"/>
                <field name="fuel_type_id" type="row"/>
                <field name="quantity" type="measure"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_secretariat_fuel_voucher_graph" model="ir.ui.view">
        <field name="name">secretariat.fuel.voucher.graph</field>
        <field name="model">secretariat.fuel.voucher</field>
        <field name="arch" type="xml">
            <graph string="Consommation de carburant" type="bar" sample="1">
                <field name="date" interval="month"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ================================================================
         ACTIONS
         ================================================================ -->
    <record id="action_secretariat_fuel_voucher" model="ir.actions.act_window">
        <field name="name">Bons de carburant</field>
        <field name="res_model">secretariat.fuel.voucher</field>
        <field name="view_mode">tree,kanban,form,pivot,graph</field>
        <field name="search_view_id" ref="view_secretariat_fuel_voucher_search"/>
        <field name="context">{'search_default_filter_this_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Enregistrez un premier bon de carburant
            </p>
            <p>
                Chaque bon reprend une ligne du carnet : numéro, date, engin,
                bénéficiaire, carburant, prix et quantité.
                Pour recopier tout un carnet, préférez le menu
                <b>Carburant → Saisie rapide</b> ; pour reprendre l'ancien
                classeur, <b>Carburant → Importer depuis Excel</b>.
            </p>
        </field>
    </record>

    <record id="action_secretariat_fuel_voucher_quick" model="ir.actions.act_window">
        <field name="name">Saisie rapide</field>
        <field name="res_model">secretariat.fuel.voucher</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_secretariat_fuel_voucher_search"/>
        <field name="context">{'search_default_filter_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Recopiez le carnet, ligne à ligne
            </p>
            <p>
                Chaque ligne se valide avec <b>Entrée</b> et ouvre
                directement la suivante. Le prix se remplit tout seul à partir
                du carburant choisi ; un avertissement s'affiche si le bon
                semble déjà saisi ou si l'engin dépasse sa dotation du mois.
            </p>
        </field>
    </record>

    <record id="action_secretariat_fuel_voucher_quick_view" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_secretariat_fuel_voucher_tree_quick"/>
        <field name="act_window_id" ref="action_secretariat_fuel_voucher_quick"/>
    </record>

    <record id="action_secretariat_fuel_voucher_quick_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_secretariat_fuel_voucher_form"/>
        <field name="act_window_id" ref="action_secretariat_fuel_voucher_quick"/>
    </record>

    <record id="action_secretariat_fuel_voucher_incomplete" model="ir.actions.act_window">
        <field name="name">Bons à compléter</field>
        <field name="res_model">secretariat.fuel.voucher</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_secretariat_fuel_voucher_search"/>
        <field name="domain">[('is_incomplete', '=', True), ('state', '!=', 'cancelled')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun bon à compléter
            </p>
            <p>
                Les bons repris de l'ancien classeur auxquels il manque un
                engin, un bénéficiaire, un prix ou une quantité apparaissent
                ici.
            </p>
        </field>
    </record>

    <record id="action_secretariat_fuel_voucher_incomplete_view" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_secretariat_fuel_voucher_tree_quick"/>
        <field name="act_window_id" ref="action_secretariat_fuel_voucher_incomplete"/>
    </record>

    <record id="action_secretariat_fuel_voucher_incomplete_view_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_secretariat_fuel_voucher_form"/>
        <field name="act_window_id" ref="action_secretariat_fuel_voucher_incomplete"/>
    </record>

</odoo>
