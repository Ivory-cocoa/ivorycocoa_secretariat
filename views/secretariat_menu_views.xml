<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         MENU PRINCIPAL — Secrétariat
         Chaque nouvelle fonctionnalité du secrétariat viendra s'ajouter
         comme une section de premier niveau sous cette racine.
         ================================================================ -->
    <menuitem id="menu_secretariat_root"
              name="Secrétariat"
              sequence="45"
              web_icon="ivorycocoa_secretariat,static/description/icon.png"
              groups="ivorycocoa_secretariat.group_secretariat_user"/>

    <!-- Point d'entrée : vue d'ensemble et actions du quotidien. -->
    <menuitem id="menu_secretariat_dashboard"
              name="Tableau de bord"
              parent="menu_secretariat_root"
              action="action_secretariat_dashboard"
              sequence="1"/>

    <!-- ================================================================
         1. CARBURANT
         ================================================================ -->
    <menuitem id="menu_secretariat_fuel"
              name="Carburant"
              parent="menu_secretariat_root"
              sequence="10"/>

    <menuitem id="menu_secretariat_fuel_voucher_quick"
              name="Saisie rapide"
              parent="menu_secretariat_fuel"
              action="action_secretariat_fuel_voucher_quick"
              sequence="5"/>

    <menuitem id="menu_secretariat_fuel_voucher"
              name="Bons de carburant"
              parent="menu_secretariat_fuel"
              action="action_secretariat_fuel_voucher"
              sequence="10"/>

    <menuitem id="menu_secretariat_fuel_voucher_incomplete"
              name="Bons à compléter"
              parent="menu_secretariat_fuel"
              action="action_secretariat_fuel_voucher_incomplete"
              sequence="20"/>

    <menuitem id="menu_secretariat_fuel_import"
              name="Importer depuis Excel"
              parent="menu_secretariat_fuel"
              action="action_secretariat_fuel_import_wizard"
              sequence="30"/>

    <menuitem id="menu_secretariat_fuel_export"
              name="Générer le classeur Excel"
              parent="menu_secretariat_fuel"
              action="action_secretariat_fuel_export_wizard"
              sequence="40"/>

    <menuitem id="menu_secretariat_fuel_monthly_report"
              name="État récapitulatif mensuel"
              parent="menu_secretariat_fuel"
              action="action_secretariat_fuel_monthly_report_wizard"
              sequence="45"/>

    <!-- Référentiels du quotidien : la secrétaire doit pouvoir les consulter
         et les compléter elle-même (elle les crée déjà depuis le bon). -->
    <menuitem id="menu_secretariat_vehicle"
              name="Engins"
              parent="menu_secretariat_fuel"
              action="action_secretariat_vehicle"
              sequence="50"/>

    <menuitem id="menu_secretariat_beneficiary"
              name="Bénéficiaires"
              parent="menu_secretariat_fuel"
              action="action_secretariat_beneficiary"
              sequence="60"/>

    <!-- ================================================================
         2. CONFIGURATION — réservée au responsable
         ================================================================ -->
    <menuitem id="menu_secretariat_config"
              name="Configuration"
              parent="menu_secretariat_root"
              sequence="90"
              groups="ivorycocoa_secretariat.group_secretariat_manager"/>

    <menuitem id="menu_secretariat_fuel_type"
              name="Types de carburant"
              parent="menu_secretariat_config"
              action="action_secretariat_fuel_type"
              sequence="10"/>

</odoo>
