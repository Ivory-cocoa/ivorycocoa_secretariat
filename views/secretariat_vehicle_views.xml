<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_secretariat_vehicle_tree" model="ir.ui.view">
        <field name="name">secretariat.vehicle.tree</field>
        <field name="model">secretariat.vehicle</field>
        <field name="arch" type="xml">
            <tree string="Engins" sample="1" decoration-danger="is_over_quota">
                <field name="currency_id" column_invisible="1"/>
                <field name="is_over_quota" column_invisible="1"/>
                <field name="name"/>
                <field name="vehicle_type" optional="show"/>
                <field name="license_plate" optional="hide"/>
                <field name="employee_id" optional="show"/>
                <field name="monthly_quota" optional="show"/>
                <field name="month_quantity" optional="show"/>
                <field name="quota_usage_rate" widget="progressbar" optional="show"
                       string="Plafond consommé"/>
                <field name="voucher_count" string="Bons"/>
                <field name="quantity_total" string="Quantité totale" optional="hide"/>
                <field name="amount_total" string="Montant total" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_secretariat_vehicle_form" model="ir.ui.view">
        <field name="name">secretariat.vehicle.form</field>
        <field name="model">secretariat.vehicle</field>
        <field name="arch" type="xml">
            <form string="Engin">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vouchers" type="object"
                                class="oe_stat_button" icon="fa-ticket">
                            <field name="voucher_count" widget="statinfo" string="Bons"/>
                        </button>
                        <button name="action_view_month_vouchers" type="object"
                                class="oe_stat_button" icon="fa-tachometer"
                                invisible="monthly_quota &lt;= 0 and monthly_budget &lt;= 0">
                            <field name="quota_usage_rate" widget="statinfo"
                                   string="% du plafond du mois"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivé" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ex. 2900 LP01, Moto Camara…"/></h1>
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="not is_over_quota">
                        Cet engin a dépassé sa dotation du mois en cours
                        (<field name="quota_usage_rate" class="oe_inline" widget="float"
                                digits="[16,0]"/> % du plafond consommés).
                        Le dépassement n'empêche aucune saisie : il est là pour
                        être vu et arbitré.
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="vehicle_type"/>
                            <field name="license_plate"/>
                            <field name="employee_id"
                                   options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="normalized_name" groups="base.group_no_one"/>
                        </group>
                        <group string="Dotation mensuelle">
                            <field name="monthly_quota"/>
                            <field name="monthly_budget"/>
                            <field name="month_quantity" readonly="1"/>
                            <field name="month_amount" readonly="1"/>
                            <field name="quota_usage_rate" widget="progressbar" readonly="1"
                                   invisible="monthly_quota &lt;= 0 and monthly_budget &lt;= 0"/>
                            <field name="is_over_quota" invisible="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_secretariat_vehicle_search" model="ir.ui.view">
        <field name="name">secretariat.vehicle.search</field>
        <field name="model">secretariat.vehicle</field>
        <field name="arch" type="xml">
            <search string="Engins">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="employee_id"/>
                <filter name="filter_over_quota" string="En dépassement"
                        domain="[('is_over_quota', '=', True)]"/>
                <filter name="filter_with_quota" string="Avec dotation"
                        domain="['|', ('monthly_quota', '&gt;', 0), ('monthly_budget', '&gt;', 0)]"/>
                <separator/>
                <filter name="groupby_type" string="Type"
                        context="{'group_by': 'vehicle_type'}"/>
                <filter name="filter_archived" string="Archivés"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_secretariat_vehicle" model="ir.actions.act_window">
        <field name="name">Engins</field>
        <field name="res_model">secretariat.vehicle</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_secretariat_vehicle_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Ajoutez un engin
            </p>
            <p>
                Véhicules, motos, engins d'usine ou groupes électrogènes : tout
                ce à quoi un bon de carburant peut être destiné. Une
                <b>dotation mensuelle</b> facultative permet de suivre les
                dépassements.
            </p>
        </field>
    </record>

    <record id="action_secretariat_vehicle_over_quota" model="ir.actions.act_window">
        <field name="name">Engins en dépassement</field>
        <field name="res_model">secretariat.vehicle</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_secretariat_vehicle_search"/>
        <field name="domain">[('is_over_quota', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucun engin ne dépasse sa dotation ce mois-ci
            </p>
            <p>
                Seuls les engins portant une dotation mensuelle sont surveillés.
                Renseignez-la sur la fiche de l'engin pour l'y faire figurer.
            </p>
        </field>
    </record>

</odoo>
