<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_secretariat_fuel_export_wizard_form" model="ir.ui.view">
        <field name="name">secretariat.fuel.export.wizard.form</field>
        <field name="model">secretariat.fuel.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer le classeur Excel">
                <field name="state" invisible="1"/>

                <div invisible="state != 'config'">
                    <div class="alert alert-info" role="alert">
                        Le classeur généré reprend la présentation du carnet :
                        une feuille par mois (« Janvier 2026 »), les huit mêmes
                        colonnes, une ligne de total en bas de feuille. Il peut
                        être réimporté tel quel.
                    </div>
                    <group>
                        <group string="Période">
                            <field name="all_dates"/>
                            <field name="date_from" invisible="all_dates"
                                   required="not all_dates"/>
                            <field name="date_to" invisible="all_dates"
                                   required="not all_dates"/>
                        </group>
                        <group string="Contenu">
                            <field name="include_cancelled"/>
                            <field name="include_totals"/>
                            <field name="include_summary"/>
                        </group>
                    </group>
                    <group string="Filtres (facultatifs)">
                        <field name="fuel_type_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="vehicle_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="beneficiary_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </div>

                <div invisible="state != 'done'">
                    <div class="alert alert-success" role="alert">
                        Classeur généré : <field name="voucher_count" class="oe_inline"
                                                 readonly="1" nolabel="1"/> bon(s).
                        Cliquez sur le lien pour le télécharger.
                    </div>
                    <group>
                        <field name="file_data" filename="file_name" readonly="1"
                               string="Classeur Excel"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                </div>

                <footer>
                    <button name="action_generate" type="object" string="Générer"
                            class="btn-primary" invisible="state != 'config'"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_secretariat_fuel_export_wizard" model="ir.actions.act_window">
        <field name="name">Générer le classeur Excel</field>
        <field name="res_model">secretariat.fuel.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
