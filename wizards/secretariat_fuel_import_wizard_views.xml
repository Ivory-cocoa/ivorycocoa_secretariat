<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_secretariat_fuel_import_wizard_form" model="ir.ui.view">
        <field name="name">secretariat.fuel.import.wizard.form</field>
        <field name="model">secretariat.fuel.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer les bons de carburant">
                <field name="state" invisible="1"/>

                <!-- ÉTAPE 1 : le fichier -->
                <group invisible="state == 'done'">
                    <group string="Classeur Excel">
                        <field name="file_data" filename="file_name"
                               widget="binary" string="Fichier (.xlsx)"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <group string="Options">
                        <field name="create_missing"/>
                        <field name="skip_duplicates"/>
                        <field name="target_state"/>
                        <field name="supplier_id" options="{'no_create_edit': True}"/>
                    </group>
                </group>

                <div class="alert alert-info" role="alert" invisible="state != 'upload'">
                    Le fichier doit reprendre les colonnes du carnet :
                    <b>Numéro, Date, Engin, Nom, Carburant, Prix Unitaire,
                    Quantité, Total</b>. La ligne d'en-tête est détectée
                    automatiquement, quelle que soit sa position dans les dix
                    premières lignes. Les lignes sans numéro de bon (totaux de
                    bas de feuille) sont ignorées.
                </div>

                <!-- ÉTAPE 2 : choix des feuilles -->
                <div invisible="state != 'analyzed'">
                    <div class="alert alert-info" role="alert">
                        Décochez les feuilles à ne pas reprendre. Les lignes déjà
                        présentes en base — ou recopiées d'une feuille à l'autre —
                        sont comptées comme doublons et ne seront pas réimportées.
                    </div>
                    <field name="sheet_ids" nolabel="1">
                        <tree editable="bottom" create="false" delete="false">
                            <field name="selected" string="Importer"/>
                            <field name="name" readonly="1"/>
                            <field name="row_count" readonly="1"/>
                            <field name="new_count" readonly="1" sum="Total à créer"/>
                            <field name="duplicate_count" readonly="1" sum="Doublons"/>
                            <field name="error_count" readonly="1" sum="Erreurs"/>
                        </tree>
                    </field>
                </div>

                <!-- ÉTAPE 3 : compte rendu -->
                <div invisible="state != 'done'">
                    <group>
                        <group string="Résultat">
                            <field name="imported_count"/>
                            <field name="duplicate_count" string="Doublons ignorés"/>
                            <field name="error_count"/>
                        </group>
                        <group string="Référentiels créés">
                            <field name="created_vehicle_count"/>
                            <field name="created_beneficiary_count"/>
                            <field name="created_fuel_count"/>
                        </group>
                    </group>
                    <field name="result_html" nolabel="1" readonly="1"/>
                    <group invisible="not error_file">
                        <field name="error_file" filename="error_file_name"
                               string="Lignes rejetées (CSV)"/>
                        <field name="error_file_name" invisible="1"/>
                    </group>
                </div>

                <footer>
                    <button name="action_analyze" type="object" string="Analyser le fichier"
                            class="btn-primary" invisible="state != 'upload'"/>
                    <button name="action_import" type="object" string="Importer"
                            class="btn-primary" invisible="state != 'analyzed'"
                            confirm="Lancer l'import des feuilles sélectionnées ?"/>
                    <button name="action_back" type="object" string="Retour"
                            class="btn-secondary" invisible="state != 'analyzed'"/>
                    <button name="action_view_imported" type="object"
                            string="Voir les bons importés" class="btn-primary"
                            invisible="state != 'done'"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_secretariat_fuel_import_wizard" model="ir.actions.act_window">
        <field name="name">Importer depuis Excel</field>
        <field name="res_model">secretariat.fuel.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
