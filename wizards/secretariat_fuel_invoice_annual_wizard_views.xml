<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_secretariat_fuel_invoice_annual_wizard_form" model="ir.ui.view">
        <field name="name">secretariat.fuel.invoice.annual.wizard.form</field>
        <field name="model">secretariat.fuel.invoice.annual.wizard</field>
        <field name="arch" type="xml">
            <form string="État annuel des factures">
                <div class="alert alert-info" role="alert"
                     invisible="state == 'done'">
                    Le montant facturé mois par mois, station par station, sur
                    l'année entière. Le PDF sert à la direction, le classeur
                    Excel à la comptabilité — les deux portent exactement les
                    mêmes chiffres.
                </div>
                <group invisible="state == 'done'">
                    <group string="Période et portée">
                        <field name="year"/>
                        <field name="station_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Contenu">
                        <field name="amount_basis" widget="radio"/>
                        <field name="include_draft"/>
                        <field name="compare_previous"/>
                    </group>
                </group>

                <div invisible="state != 'done'" class="text-center">
                    <div class="alert alert-success" role="alert">
                        <i class="fa fa-check-circle"/> Le classeur est prêt.
                    </div>
                    <field name="file_data" filename="file_name" readonly="1"
                           widget="binary"/>
                    <field name="file_name" invisible="1"/>
                </div>
                <field name="state" invisible="1"/>

                <footer>
                    <button name="action_print" type="object"
                            string="Imprimer le PDF" class="btn-primary"
                            icon="fa-file-pdf-o" invisible="state == 'done'"/>
                    <button name="action_generate_xlsx" type="object"
                            string="Générer l'Excel" class="btn-secondary"
                            icon="fa-file-excel-o" invisible="state == 'done'"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_secretariat_fuel_invoice_annual_wizard" model="ir.actions.act_window">
        <field name="name">État annuel des factures</field>
        <field name="res_model">secretariat.fuel.invoice.annual.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
