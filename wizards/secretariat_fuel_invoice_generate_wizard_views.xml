<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_secretariat_fuel_invoice_generate_wizard_form" model="ir.ui.view">
        <field name="name">secretariat.fuel.invoice.generate.wizard.form</field>
        <field name="model">secretariat.fuel.invoice.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer les factures de la quinzaine">
                <div class="alert alert-info" role="alert">
                    Une facture par station, reprenant tous les bons servis sur
                    la quinzaine et pas encore facturés. Rien n'est écrit tant
                    que vous n'avez pas cliqué sur <b>Générer</b> : l'aperçu
                    ci-dessous montre exactement ce qui sera créé.
                </div>
                <group>
                    <group string="Quinzaine">
                        <label for="period_half" string="Période"/>
                        <div class="o_row">
                            <field name="period_half" class="oe_inline" nolabel="1"/>
                            <field name="period_month" class="oe_inline" nolabel="1"/>
                            <field name="period_year" class="oe_inline" nolabel="1"/>
                        </div>
                        <label for="date_from" string="Du"/>
                        <div class="o_row">
                            <field name="date_from" readonly="1" class="oe_inline"/>
                            <span class="mx-1">au</span>
                            <field name="date_to" readonly="1" class="oe_inline"/>
                        </div>
                        <button name="action_previous_half" type="object"
                                string="Quinzaine précédente" class="btn-link ps-0"
                                icon="fa-arrow-left"/>
                    </group>
                    <group string="Portée">
                        <field name="station_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="default_station_id"/>
                        <field name="assign_default_station"
                               invisible="not default_station_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="candidate_count" readonly="1"/>
                        <field name="orphan_count" readonly="1"
                               invisible="orphan_count == 0"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert"
                     invisible="default_station_id">
                    Aucune station par défaut n'est définie pour la société.
                    Les bons dont la station n'est pas renseignée ne pourront
                    pas être facturés — renseignez-la dans
                    <b>Configuration → Paramètres du secrétariat</b>.
                </div>
                <group string="Aperçu">
                    <field name="preview_html" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_generate" type="object"
                            string="Générer les factures" class="btn-primary"
                            invisible="candidate_count == 0"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_secretariat_fuel_invoice_generate_wizard" model="ir.actions.act_window">
        <field name="name">Générer les factures de la quinzaine</field>
        <field name="res_model">secretariat.fuel.invoice.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
