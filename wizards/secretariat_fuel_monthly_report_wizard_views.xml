<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_secretariat_fuel_monthly_report_wizard_form" model="ir.ui.view">
        <field name="name">secretariat.fuel.monthly.report.wizard.form</field>
        <field name="model">secretariat.fuel.monthly.report.wizard</field>
        <field name="arch" type="xml">
            <form string="État récapitulatif mensuel">
                <div class="alert alert-info" role="alert">
                    L'état reprend les totaux du mois — par carburant, par
                    engin et par bénéficiaire — signale les dépassements de
                    dotation, et se termine par une ligne de signature.
                </div>
                <group>
                    <group string="Période">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <button name="action_previous_month" type="object"
                                string="Mois précédent" class="btn-link ps-0"
                                icon="fa-arrow-left"/>
                    </group>
                    <group string="Contenu">
                        <field name="include_draft"/>
                        <field name="include_detail"/>
                        <field name="signatory"/>
                    </group>
                </group>
                <group string="Filtres (facultatifs)">
                    <field name="fuel_type_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="vehicle_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                    <field name="beneficiary_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Imprimer l'état"
                            class="btn-primary"/>
                    <button string="Fermer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_secretariat_fuel_monthly_report_wizard" model="ir.actions.act_window">
        <field name="name">État récapitulatif mensuel</field>
        <field name="res_model">secretariat.fuel.monthly.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
