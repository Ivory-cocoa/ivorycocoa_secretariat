<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_secretariat_merge_wizard_form" model="ir.ui.view">
        <field name="name">secretariat.merge.wizard.form</field>
        <field name="model">secretariat.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Fusionner">
                <field name="kind" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    Les bons des enregistrements absorbés seront reportés sur
                    celui que vous conservez, puis les absorbés seront
                    supprimés. <b>L'opération est irréversible</b> — mais les
                    anciens libellés restent notés sur l'enregistrement
                    conservé, et donc retrouvables par la recherche.
                </div>
                <group>
                    <group string="À fusionner">
                        <field name="vehicle_ids" widget="many2many_tags"
                               invisible="kind != 'vehicle'" readonly="1"/>
                        <field name="beneficiary_ids" widget="many2many_tags"
                               invisible="kind != 'beneficiary'" readonly="1"/>
                        <field name="record_count" string="Sélectionnés"/>
                    </group>
                    <group string="À conserver">
                        <field name="target_vehicle_id"
                               invisible="kind != 'vehicle'"
                               required="kind == 'vehicle'"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="target_beneficiary_id"
                               invisible="kind != 'beneficiary'"
                               required="kind == 'beneficiary'"
                               options="{'no_create': True, 'no_open': True}"/>
                        <field name="voucher_count"/>
                    </group>
                </group>
                <group string="Sera supprimé">
                    <field name="absorbed_names" nolabel="1" readonly="1"/>
                </group>
                <footer>
                    <button name="action_merge" type="object" string="Fusionner"
                            class="btn-primary"
                            confirm="Confirmez-vous la fusion ? Elle est irréversible."/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Entrées du menu « Action » des listes d'engins et de bénéficiaires. -->
    <record id="action_secretariat_merge_vehicle" model="ir.actions.act_window">
        <field name="name">Fusionner les engins</field>
        <field name="res_model">secretariat.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_secretariat_vehicle"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="action_secretariat_merge_beneficiary" model="ir.actions.act_window">
        <field name="name">Fusionner les bénéficiaires</field>
        <field name="res_model">secretariat.merge.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_secretariat_fuel_beneficiary"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
