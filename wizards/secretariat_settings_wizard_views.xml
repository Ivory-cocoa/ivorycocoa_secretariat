<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_secretariat_settings_wizard_form" model="ir.ui.view">
        <field name="name">secretariat.settings.wizard.form</field>
        <field name="model">secretariat.settings.wizard</field>
        <field name="arch" type="xml">
            <form string="Paramètres du secrétariat">
                <group>
                    <group string="Facturation">
                        <field name="station_id"
                               options="{'no_create_edit': True}"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Délai d'utilisation des bons">
                        <field name="usage_alert_days"/>
                        <field name="usage_critical_days"/>
                    </group>
                </group>
                <group string="Numérotation des bons">
                    <group>
                        <field name="voucher_next_number"/>
                        <field name="voucher_padding"/>
                    </group>
                    <group>
                        <field name="highest_number"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    Le numéro est <b>proposé</b> à la saisie, jamais imposé :
                    si la souche papier porte un autre numéro, corrigez-le, et
                    le compteur se recalera tout seul au-dessus du plus grand
                    numéro enregistré.
                </div>
                <footer>
                    <button name="action_save" type="object" string="Enregistrer"
                            class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_secretariat_settings_wizard" model="ir.actions.act_window">
        <field name="name">Paramètres du secrétariat</field>
        <field name="res_model">secretariat.settings.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
